# GlitchTip host env — copy to /etc/vylex/glitchtip.env on the Hetzner box.
# Generate strong values; never commit the real file.
#
#   GLITCHTIP_SECRET_KEY        -> openssl rand -hex 50
#   GLITCHTIP_POSTGRES_PASSWORD -> openssl rand -hex 24

GLITCHTIP_SECRET_KEY=
GLITCHTIP_POSTGRES_PASSWORD=

# Optional. Leave consolemail:// until SMTP is wired; then point at one.com:
#   smtp+tls://vylexai%40smithagency.de:PASSWORD@send.one.com:465
GLITCHTIP_EMAIL_URL=consolemail://

# Leave true for the very first signup, then set false + recreate the web
# container to lock the instance down to existing users only.
GLITCHTIP_OPEN_REGISTRATION=true
